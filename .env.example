DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars-long"

# URL base da aplicação (usada para montar o link de confirmação no e-mail)
APP_URL="http://localhost:3000"

# LiveKit (crie uma conta grátis em https://cloud.livekit.io e cole as chaves do projeto)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL="wss://seu-projeto.livekit.cloud"

# SMTP para enviar código de verificação no cadastro.
# Se deixar vazio, o código aparece no console do servidor (modo dev).
# Opcao 1: https://myaccount.google.com/apppasswords
# Opcao 2: Brevo (https://www.brevo.com/pt/), usando o recurso SMTP Relay (https://www.brevo.com/pt/smtp-relay/) e gerando uma senha de API específica para SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Google OAuth (crie credenciais em https://console.cloud.google.com → APIs & Services → Credentials)
# Adicione "http://localhost:3000/api/auth/google/callback" como Authorized redirect URI
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
